# Copy to `.env` for `docker compose`; never commit secrets.
NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
LARDER_AGENT_TOKEN=agt_replace-with-minted-agent-token
# Headless kiro-cli auth — skips interactive browser login.
KIRO_API_KEY=
