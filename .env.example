# Written by `neon deploy` / `neon env pull`
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full
NEON_AUTH_BASE_URL=https://example.neonauth.eu-central-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://example.neonauth.eu-central-1.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Application config, not injected by Neon.
# 32+ bytes, base64: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=

# Bearer token for the read-only MCP endpoint at /api/mcp.
LARDER_MCP_TOKEN=
