# Neon (pooled connection string for serverless functions)
DATABASE_URL=postgres://user:password@host-pooler.neon.tech/larder?sslmode=require

# The single passphrase for signing in (M1 auth)
APP_PASSPHRASE=choose-a-long-one

# 32+ bytes of entropy, used to sign the session cookie
SESSION_SECRET=replace-with-openssl-rand-base64-32
